}

ParkingSpot.java
public class ParkingSpot {
    private final String id;
    private final VehicleType spotType;
    private boolean isAvailable;
    private Vehicle parkedVehicle;

    public ParkingSpot(String id, VehicleType spotType) {
        this.id = id;
        this.spotType = spotType;
        this.isAvailable = true;
    }

    public boolean isAvailable() { return isAvailable; }
    public VehicleType getSpotType() { return spotType; }
    public String getId() { return id; }

    public void assignVehicle(Vehicle vehicle) {
        if (!isAvailable || vehicle.getType() != spotType) {
            throw new IllegalStateException("Spot not available or invalid vehicle type");
        }
        this.parkedVehicle = vehicle;
        this.isAvailable = false;
    }

    public void vacateSpot() {
        this.parkedVehicle = null;
        this.isAvailable = true;
    }
}

Ticket.java
import java.time.LocalDateTime;
import java.util.UUID;

public class Ticket {
    private final String ticketId;
    private final Vehicle vehicle;
    private final String spotId;
    private final LocalDateTime entryTime;
    private LocalDateTime exitTime;
    private double totalFee;

    public Ticket(Vehicle vehicle, String spotId) {
        this.ticketId = UUID.randomUUID().toString();
        this.vehicle = vehicle;
        this.spotId = spotId;
        this.entryTime = LocalDateTime.now();
    }

    public void closeTicket(double fee) {
        this.exitTime = LocalDateTime.now();
        this.totalFee = fee;
    }

    public Vehicle getVehicle() { return vehicle; }
    public String getSpotId() { return spotId; }
    public double getTotalFee() { return totalFee; }
    public LocalDateTime getEntryTime() { return entryTime; }
}


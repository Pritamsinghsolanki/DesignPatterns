ParkingService.java
import java.time.Duration;
import java.time.LocalDateTime;
import java.util.*;

public class ParkingService {
    private final Map<String, ParkingSpot> parkingSpots = new HashMap<>();
    private final Map<String, Ticket> activeTickets = new HashMap<>();
    private final RateCardService rateCardService = new RateCardService();
    private final PaymentService paymentService = new PaymentService();

    public ParkingService(List<ParkingSpot> spots) {
        for (ParkingSpot spot : spots) {
            parkingSpots.put(spot.getId(), spot);
        }
    }

    public Ticket parkVehicle(Vehicle vehicle) {
        Optional<ParkingSpot> spotOpt = parkingSpots.values().stream()
                .filter(s -> s.isAvailable() && s.getSpotType() == vehicle.getType())
                .findFirst();

        if (spotOpt.isEmpty()) {
            throw new RuntimeException("No available spot for vehicle type: " + vehicle.getType());
        }

        ParkingSpot spot = spotOpt.get();
        spot.assignVehicle(vehicle);

        Ticket ticket = new Ticket(vehicle, spot.getId());
        activeTickets.put(ticket.getTicketId(), ticket);
        return ticket;
    }

    public Payment unparkVehicle(String ticketId, PaymentMode mode) {
        Ticket ticket = activeTickets.get(ticketId);
        if (ticket == null) throw new RuntimeException("Invalid ticket");

        ParkingSpot spot = parkingSpots.get(ticket.getSpotId());
        double fee = calculateFee(ticket);

        Payment payment = paymentService.processPayment(ticketId, fee, mode);
        if (payment.getStatus() == PaymentStatus.SUCCESS) {
            ticket.closeTicket(fee);
            spot.vacateSpot();
            activeTickets.remove(ticketId);
        }
        return payment;
    }

    private double calculateFee(Ticket ticket) {
        LocalDateTime now = LocalDateTime.now();
        long hours = Math.max(1, Duration.between(ticket.getEntryTime(), now).toHours());
        double rate = rateCardService.getRate(ticket.getVehicle().getType());
        return rate * hours;
    }
}

🎮 3️⃣ Controllers (Simulated Entry/Exit Gates)
EntryGateController.java
public class EntryGateController {
    private final ParkingService parkingService;

    public EntryGateController(ParkingService parkingService) {
        this.parkingService = parkingService;
    }

    public Ticket handleVehicleEntry(Vehicle vehicle) {
        return parkingService.parkVehicle(vehicle);
    }
}

ExitGateController.java
public class ExitGateController {
    private final ParkingService parkingService;

    public ExitGateController(ParkingService parkingService) {
        this.parkingService = parkingService;
    }

    public Payment handleVehicleExit(String ticketId, PaymentMode mode) {
        return parkingService.unparkVehicle(ticketId, mode);
    }
}

🧪 4️⃣ Demo: Main Class Example
ParkingLotApp.java
import java.util.List;

public class ParkingLotApp {
    public static void main(String[] args) throws InterruptedException {
        List<ParkingSpot> spots = List.of(
            new ParkingSpot("S1", VehicleType.CAR),
            new ParkingSpot("S2", VehicleType.BIKE)
        );

        ParkingService parkingService = new ParkingService(spots);
        EntryGateController entryGate = new EntryGateController(parkingService);
        ExitGateController exitGate = new ExitGateController(parkingService);

        // 1️⃣ Vehicle enters
        Vehicle car = new Vehicle("HR26AB1234", VehicleType.CAR);
        Ticket ticket = entryGate.handleVehicleEntry(car);
        System.out.println("Ticket issued: " + ticket.getSpotId());

        // Simulate parking duration
        Thread.sleep(2000);

        // 2️⃣ Vehicle exits
        Payment payment = exitGate.handleVehicleExit(ticket.getTicketId(), PaymentMode.UPI);
        System.out.println("Payment Status: " + payment.getStatus() + ", Amount: " + payment.getAmount());
    }
}

💡 5️⃣ Design Highlights

✅ SOLID principles

SRP: Each class has one purpose.

OCP: Add new VehicleType or PaymentMode easily.

LSP: Replace ParkingService with subclass for multi-floor parking.

DIP: Services depend on abstractions, not implementations.

✅ Extensible Design

Can add a MultiFloorParkingService extending ParkingService.

Plug in real payment gateway easily.

Add async queue for ticketing/notifications.

✅ Thread Safety

If multiple gates: synchronize parkVehicle and unparkVehicle or use DB locks.

✅ Scalability

Each floor can be handled by separate service node or DB partition.
💬 STRING ALGORITHMS MASTER NOTES
1️⃣ KMP (Knuth-Morris-Pratt)

Find pattern p in text t in O(n + m).

LPS Array (Longest Prefix Suffix):

int[] buildLPS(String p) {
    int n = p.length();
    int[] lps = new int[n];
    int len = 0;
    for (int i = 1; i < n; ) {
        if (p.charAt(i) == p.charAt(len)) lps[i++] = ++len;
        else if (len > 0) len = lps[len - 1];
        else lps[i++] = 0;
    }
    return lps;
}


Search:

boolean kmp(String t, String p) {
    int[] lps = buildLPS(p);
    int i = 0, j = 0;
    while (i < t.length()) {
        if (t.charAt(i) == p.charAt(j)) { i++; j++; }
        if (j == p.length()) return true;
        else if (i < t.length() && t.charAt(i) != p.charAt(j))
            j = j > 0 ? lps[j - 1] : 0;
    }
    return false;
}

2️⃣ RABIN-KARP (Hash-Based String Matching)

O(n) expected, O(nm) worst.

boolean rabinKarp(String text, String pattern) {
    int n = text.length(), m = pattern.length();
    long base = 256, mod = 1_000_000_007;
    long hashP = 0, hashT = 0, pow = 1;

    for (int i = 0; i < m; i++) {
        hashP = (hashP * base + pattern.charAt(i)) % mod;
        hashT = (hashT * base + text.charAt(i)) % mod;
        if (i > 0) pow = (pow * base) % mod;
    }

    for (int i = 0; i <= n - m; i++) {
        if (hashP == hashT && text.substring(i, i + m).equals(pattern)) return true;
        if (i < n - m)
            hashT = ((hashT - text.charAt(i) * pow) * base + text.charAt(i + m)) % mod;
        if (hashT < 0) hashT += mod;
    }
    return false;
}

3️⃣ TRIE (Prefix Tree)

Used for auto-complete, prefix search, dictionary validation.

class TrieNode {
    TrieNode[] children = new TrieNode[26];
    boolean isWord;
}

class Trie {
    TrieNode root = new TrieNode();

    void insert(String word) {
        TrieNode node = root;
        for (char c : word.toCharArray()) {
            if (node.children[c - 'a'] == null)
                node.children[c - 'a'] = new TrieNode();
            node = node.children[c - 'a'];
        }
        node.isWord = true;
    }

    boolean search(String word) {
        TrieNode node = root;
        for (char c : word.toCharArray()) {
            if (node.children[c - 'a'] == null) return false;
            node = node.children[c - 'a'];
        }
        return node.isWord;
    }

    boolean startsWith(String prefix) {
        TrieNode node = root;
        for (char c : prefix.toCharArray()) {
            if (node.children[c - 'a'] == null) return false;
            node = node.children[c - 'a'];
        }
        return true;
    }
}
